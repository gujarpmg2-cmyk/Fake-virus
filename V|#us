import tkinter as tk
import time
import threading
import random

fake_issues = [
    "Memory optimization anomaly",
    "Unknown process signature",
    "Temporary cache inconsistency",
]

root = tk.Tk()
root.title("Security Alert")
root.geometry("520x260")
root.configure(bg="#181818")

tk.Label(
    root,
    text="⚠️ SYSTEM WARNING",
    font=("Segoe UI", 18, "bold"),
    fg="#ff5555",
    bg="#181818",
).pack(pady=12)

status = tk.Label(
    root,
    text="A simulated issue was detected.",
    font=("Segoe UI", 11),
    fg="white",
    bg="#181818",
)
status.pack(pady=8)

progress = tk.Label(root, text="", fg="#dddddd", bg="#181818")
progress.pack(pady=8)

def clean():
    threading.Thread(target=scan, daemon=True).start()

def scan():
    for i in range(1, 101):
        issue = random.choice(fake_issues)
        status.config(text=f"Scanning: {issue}")
        progress.config(text=f"{i}%")
        time.sleep(0.025)

    status.config(text="✅ Simulation complete — no real threats found.")
    progress.config(text="Your system was never modified.")

tk.Button(
    root,
    text="Run harmless simulation",
    command=clean,
    width=24,
).pack(pady=16)

tk.Label(
    root,
    text="This is a fictional demo. It does not inspect or modify your computer.",
    fg="#aaaaaa",
    bg="#181818",
).pack(side="bottom", pady=10)

root.mainloop()
